generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per NSE-listed equity (universe). Snapshot quote fields come from
// the Yahoo screener; indicator fields are computed from 2y close series.
model Stock {
  symbol       String   @id // e.g. RELIANCE.NS
  name         String
  exchangeCode String? // NSI (mainboard) / NCM (SME)

  // Snapshot quote
  price        Float?
  prevClose    Float?
  changePct    Float?
  open         Float?
  dayHigh      Float?
  dayLow       Float?
  volume       Float?
  avgVol3M     Float?
  marketCap    Float? // INR
  peTTM        Float?
  epsTTM       Float?
  bookValue    Float?
  pbRatio      Float?
  divYield     Float?
  high52       Float?
  low52        Float?
  sma50Yahoo   Float? // 50-day average from Yahoo snapshot
  sma200Yahoo  Float? // 200-day average from Yahoo snapshot

  // Computed indicators (from 2y daily closes)
  sma20        Float?
  sma50        Float?
  sma200       Float?
  ema20        Float?
  rsi14        Float?
  macd         Float?
  macdSignal   Float?
  macdHist     Float?
  atr14Pct     Float? // avg true range % (volatility proxy from closes)
  mom1M        Float? // % return ~21 trading days
  mom3M        Float? // ~63 days
  mom6M        Float? // ~126 days
  fromHighPct  Float? // % below 52w high (0 = at high)
  fromLowPct   Float? // % above 52w low

  // Extended indicators (Task 25) — weekly timeframe, Bollinger, price-vs-MA
  wRsi14        Float? // RSI(14) on weekly closes
  wMacdHist     Float? // MACD(12,26,9) histogram on weekly closes
  bbPctB        Float? // Bollinger %B (20, 2σ) on daily closes, 0-100 (100 = at upper band)
  bbWidthPct    Float? // Bollinger band width as % of the mid line (squeeze = low)
  emaCross      Boolean? // ema20 > ema50
  distSma20Pct  Float? // (price / sma20 - 1) * 100 — negative = below the MA
  distSma50Pct  Float?
  distSma100Pct Float?
  distSma200Pct Float?
  distEma20Pct  Float?
  distEma50Pct  Float?
  distEma100Pct Float?
  distEma200Pct Float?

  // Signal flags for fast screener filtering
  aboveSma20   Boolean?
  aboveSma50   Boolean?
  aboveSma200  Boolean?
  goldenCross  Boolean? // sma20 > sma50
  volSpike     Boolean? // volume > 2x avgVol3M

  // 2y close series as compact JSON: [[unixTs, close], ...] ascending
  closes       String?
  closesSynced DateTime?

  // Full OHLCV bars in DailyBar (pattern scanners). barsSynced = last full pass.
  barsSynced DateTime?

  // Next earnings date (calendarEvents) — enables results calendar & earnings scans
  earningsDate   DateTime?
  earningsSynced DateTime?

  // Sector (filled by quoteSummary trickle sync / on-demand)
  sector         String?
  industry       String?
  sectorSynced   DateTime?

  // BananaPatterns-style industry hierarchy (Task 19): indGrp = industry
  // (~58, e.g. "Banks"), subGrp = subgroup (~150, e.g. "Private Sector Bank").
  // Backfilled from src/lib/taxonomy.ts (Yahoo industry map + symbol overrides).
  indGrp       String?
  subGrp       String?

  // Quarterly financials (quoteSummary trickle) — ratios as decimals (0.35 = +35%)
  epsQuarterlyGrowth Float? // latest Q diluted EPS vs year-ago Q (Yahoo earningsQuarterlyGrowth)
  revenueQoQGrowth   Float? // latest Q totalRevenue vs prior Q
  netIncome3YCagr    Float? // 3-year net income CAGR from the annual income statement
  financialsSynced   DateTime?

  // MarketSmith-style ratings — recomputed over the whole universe after syncs
  rsRating  Int?    // 1-99: percentile of 12M weighted momentum (0.4·3M + 0.2·6M + 0.2·9M + 0.2·12M)
  epsScore  Int?    // 1-99: composite percentile of EPS Q-growth, 3Y NI CAGR and revenue QoQ
  adRating  String? // A+ … E: 13-week up-day vs down-day volume classification

  // Weekly OHLC of the current (Mon-anchored) week candle — rebuilt by the bars
  // trickle so the screener builder can run Weekly-timeframe price conditions.
  wOpen  Float?
  wHigh  Float?
  wLow   Float?
  wClose Float?

  // Long-horizon performance + all-time-high distance, computed from the
  // (6y) close series during the closes phase. Null until the series is long
  // enough (recent IPOs / first sync).
  mom3Y      Float? // % return ~756 trading days
  mom5Y      Float? // % return ~1260 trading days
  fromAthPct Float? // % below the highest close in the synced history (0 = at ATH)
  quoteTime      DateTime?
  universeSynced DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([marketCap])
  @@index([changePct])
  @@index([sector])
  @@index([rsi14])
  @@index([indGrp])
  @@index([subGrp])
  @@index([rsRating])
  @@index([epsScore])
}

// OHLCV daily bars, fetched on demand for stock detail views and cached.
model DailyBar {
  id     String @id @default(cuid())
  symbol String
  date   String // YYYY-MM-DD (IST)
  open   Float
  high   Float
  low    Float
  close  Float
  volume Float

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  note      String?
  createdAt DateTime @default(now())
}

model PriceAlert {
  id          String    @id @default(cuid())
  symbol      String
  condition   String // "above" | "below"
  target      Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  triggeredPc Float?
  createdAt   DateTime  @default(now())

  @@index([symbol])
}

// Single-row sync state for the universe pipeline.
// Pipeline timestamps (Task 46): lastIngestAt = last successful ingest
// completion (hard-gate for user-triggered syncs); metricsDate/scansDate =
// the EOD session the precomputed stock_metrics / scan_results cover.
model SyncState {
  id            String    @id @default("main")
  phase         String    @default("idle") // idle | universe | closes | sectors | done
  status        String    @default("idle") // idle | running | done | error
  universeTotal Int       @default(0)
  universeDone  Int       @default(0)
  closesTotal   Int       @default(0)
  closesDone    Int       @default(0)
  sectorsTotal  Int       @default(0)
  sectorsDone   Int       @default(0)
  barsTotal     Int       @default(0)
  barsDone      Int       @default(0)
  earningsTotal Int       @default(0)
  earningsDone  Int       @default(0)
  financialsTotal Int     @default(0)
  financialsDone  Int     @default(0)
  fundamentalsTotal Int   @default(0)
  fundamentalsDone  Int   @default(0)
  ratingsSynced DateTime?
  lastError     String?
  startedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  // Precompute pipeline bookkeeping (denormalised so /api/sync GET is a
  // single-row read — no aggregates on the status path).
  lastIngestAt  DateTime? // last successful runSync completion
  lastQuoteTime DateTime? // snapshot of MAX(Stock.quoteTime) at universe phase end
  stockCount    Int?      // snapshot of Stock count at sync end
  metricsDate   String?   // YYYY-MM-DD session StockMetrics covers
  metricsSyncedAt DateTime?
  scansDate     String?   // YYYY-MM-DD session ScanResult rows cover
  scansSyncedAt DateTime?
}

// Precomputed derived indicators — ONE ROW PER SYMBOL PER SESSION, written by
// the background metrics pipeline right after the nightly ingest lands
// (never in a request path). Everything the app reads — screener fast path,
// scanners, breadth, watchlists — treats this as the flat, wide truth:
// a WHERE rsi14 < 30 AND sma20 > sma50 style query on an indexed table.
// Ratings (rsRating/epsScore/adRating) are carried over from Stock after the
// ratings recompute; price context comes from the session's own bars.
model StockMetrics {
  id Int @id @default(autoincrement())

  symbol String // e.g. RELIANCE.NS
  date   String // YYYY-MM-DD (IST) session the metrics are computed as-of

  // --- price / volume context -------------------------------------------
  close        Float?
  volume       Float?
  avgVol20     Float? // 20-session average volume
  avgVol50     Float? // 50-session average volume
  volVsAvg20   Float? // today's volume / avgVol20
  turnover20Cr Float? // close × avgVol20 / 1e7 (₹ crore)

  // --- moving averages ----------------------------------------------------
  sma20  Float?
  sma50  Float?
  sma100 Float?
  sma200 Float?
  ema20  Float?
  ema50  Float?
  ema200 Float?

  // --- oscillators ---------------------------------------------------------
  rsi14      Float?
  wRsi14     Float? // carried from Stock (weekly closes)
  macd       Float?
  macdSignal Float?
  macdHist   Float?
  wMacdHist  Float? // carried from Stock
  atr14Pct   Float?
  bbPctB     Float?
  bbWidthPct Float?

  // --- momentum ------------------------------------------------------------
  mom1M  Float? // % return ~21 sessions
  mom3M  Float? // ~63
  mom6M  Float? // ~126
  mom12M Float? // ~252

  // --- 52-week positioning ---------------------------------------------------
  high52      Float?
  low52       Float?
  fromHighPct Float? // % below the 52w high (0 = at the high)
  fromLowPct  Float? // % above the 52w low

  // --- boolean flags ----------------------------------------------------------
  aboveSma20  Boolean?
  aboveSma50  Boolean?
  aboveSma200 Boolean?
  goldenCross Boolean? // sma20 > sma50
  emaCross    Boolean? // ema20 > ema50
  volSpike    Boolean? // volume > 2× avgVol3M (from the snapshot)

  // --- carried ratings (MarketSmith-style, universe-ranked) ----------------
  rsRating  Int?    // 1-99 percentile of the 12M weighted momentum
  rsMomentum Float? // the raw weighted 12M return the rating ranks
  epsScore  Int?    // 1-99 composite fundamental growth percentile
  adRating  String? // A+ … E accumulation/distribution grade
  adRatio   Float?  // raw 13-week up-volume / down-volume ratio

  // --- TradingView-style extended technicals (computed from OHLCV bars) ---
  sma10  Float?
  ema10  Float?
  ema100 Float?
  momentum10 Float? // % return over 10 sessions

  stochK    Float? // Stochastic %K (14, 3, 3)
  stochD    Float? // Stochastic %D (signal of %K)
  adx14     Float? // trend-strength 0-100
  cci20     Float?
  williamsR Float? // Williams %R (14), 0 to -100
  ao        Float? // Awesome Oscillator (median-price SMA5 − SMA34)
  uo        Float? // Ultimate Oscillator (7, 14, 28)

  stVal Float? // Supertrend (10, 3×ATR) line value
  stDir Int?   // Supertrend direction: 1 = uptrend (price above), -1 = downtrend

  atr14    Float? // absolute ATR(14) in ₹
  gapPct   Float? // (open − prev close) / prev close × 100

  avgVol10     Float?
  avgVol30     Float?
  avgVol90     Float?
  valueTradedCr Float? // close × volume / 1e7 (₹ crore, session turnover)

  perf1W  Float? // % return over ~5 sessions
  perfYTD Float? // % return since Jan 1 (first close of the year)
  perf3Y  Float? // carried from Stock.mom3Y (6y close series)
  perf5Y  Float? // carried from Stock.mom5Y

  volatM Float? // annualised σ of daily returns over 21 sessions, %
  volatW Float? // annualised σ of weekly returns over 8 weeks, %
  beta1Y Float? // 1Y beta vs ^NSEI (cov/var of daily returns)

  rangeTight20 Float? // 20-session high-low range as % of close (VCP tightness proxy)
  fromAthPct   Float? // carried from Stock (0 = at the synced-history high)

  techScore  Int?    // composite −1..+1 scaled to −100..+100 (oscillators + MAs)
  techRating String? // Strong Sell | Sell | Neutral | Buy | Strong Buy (composite)
  oscRating  String? // oscillator-group rating
  maRating   String? // moving-average-group rating

  computedAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([date])
  @@index([rsi14])
  @@index([rsRating])
  @@index([mom6M])
  @@index([fromHighPct])
}

// Nightly-cached scanner output — all fixed scanners run once per EOD session
// in the background; a user click then reads ONE cached row (single-digit ms)
// instead of recomputing. resultJson holds the full wire payload (columns +
// rows) exactly as POST /api/scanners/[id] returns it. The Condition Builder
// keeps live computation against StockMetrics/DailyBar by design.
model ScanResult {
  id         Int      @id @default(autoincrement())
  scannerId  String // e.g. trader-choice-1
  date       String // YYYY-MM-DD (IST) data session the results are as-of
  resultJson String // full ScanResult wire payload
  rowCount   Int      @default(0)
  scanned    Int      @default(0)
  durationMs Int      @default(0)
  computedAt DateTime @default(now())

  @@unique([scannerId, date])
  @@index([date])
}

// Fundamentals from Yahoo info/statements, refreshed WEEKLY into this table
// (never mixed with the quote snapshot). Unit normalisation happens at
// ingestion: dividendYield (Yahoo mixes % and fractions) is stored as %,
// debtToEquity as a plain ratio, all money fields in INR absolute.
// A null field means "no data" — the screener treats it as no match and the
// results header reports "Fundamental data available for X of N stocks".
model StockFundamentals {
  symbol    String   @id
  fetchedAt DateTime @default(now())

  // snapshot (Yahoo quoteSummary defaultKeyStatistics / summaryDetail / financialData)
  mcap           Float? // marketCap, INR
  pe             Float? // trailing P/E
  pb             Float? // price / book
  divYield       Float? // %, normalised
  epsTtm         Float? // INR / share
  bookValue      Float? // INR / share
  roe            Float? // % (returnOnEquity × 100)
  profitMargin   Float? // %
  opMargin       Float? // %
  debtToEquity   Float? // ratio (Yahoo value / 100 when reported as %)
  currentRatio   Float? // ratio
  ev             Float? // enterprise value, INR
  evEbitda       Float? // ×
  evRevenue      Float? // ×
  psTtm          Float? // ×
  dividendRate   Float? // INR / share
  payoutRatio    Float? // %
  roa            Float? // %
  grossMargin    Float? // %
  quickRatio     Float? // ratio
  revenueTtm     Float? // INR
  ebitda         Float? // INR
  netIncome      Float? // INR
  fcf            Float? // INR
  ocf            Float? // INR
  totalDebt      Float? // INR
  totalCash      Float? // INR
  sharesOut      Float? // count
  revenueGrowth  Float? // % YoY
  earningsGrowth Float? // % YoY
  epsGrowthQoQ   Float? // %
  epsGrowthYoY   Float? // %
  epsCagr3Y      Float? // % (needs 4 annual periods)
  fwdEps         Float? // P2 — approximate
  fwdPe          Float? // P2 — approximate
  peg            Float? // P2 — approximate
  instHoldingPct Float? // P2 — proxy
  insiderHoldingPct Float? // P2 — proxy

  // Statement-sourced fields (cashflowStatementHistory / balanceSheetHistory /
  // incomeStatementHistory annuals, latest FY) + analyst consensus (financialData)
  beta            Float? // 5y monthly beta from summaryDetail
  analystRating   Float? // recommendationMean: 1 = Strong Buy … 5 = Strong Sell
  analystCount    Int?   // numberOfAnalystOpinions
  targetPrice     Float? // targetMeanPrice, INR
  totalAssets     Float? // INR, latest FY
  totalLiabilities Float? // INR, latest FY
  equity          Float? // stockholders' equity, INR, latest FY
  grossProfit     Float? // INR, latest FY
  operatingIncome Float? // INR, latest FY
  icf             Float? // investing cash flow, INR, latest FY

  // quarterly / annual slices, index 0 = latest (q0 / fy0)
  epsQuarterlys      Json? // [q0..q7] EPS ₹
  salesQuarterlys    Json? // [q0..q7] revenue ₹
  netProfitQuarterlys Json? // [q0..q7] net profit ₹
  annualEpss         Json? // [fy0..fy4] EPS ₹
  annualRevenues     Json? // [fy0..fy4] revenue ₹
  annualNetProfits   Json? // [fy0..fy4] net profit ₹

  @@index([fetchedAt])
}

// TradePulse user. Created on first login (Supabase Auth when configured,
// local email + password fallback otherwise); profile fields are completed
// through the mandatory first-time onboarding flow.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  supabaseId   String? @unique // Supabase auth.users id (when Supabase enabled)
  passwordHash String? // scrypt hash — local fallback mode only
  image        String?

  // Profile (onboarding). name/phone are mandatory; the rest are optional.
  name       String?
  phone      String?
  city       String?
  experience String? // beginner | intermediate | advanced
  interests  String? // comma-separated focus areas
  onboarded  Boolean  @default(false)

  // Monetization: every new account starts with a 15-day Pro trial.
  // plan/planCycle/planExpiresAt reflect the last PAID subscription;
  // effective tier is computed at session time (paid > trial > basic).
  plan          String    @default("basic") // basic | pro
  planCycle     String? // monthly | quarterly | halfyearly | annual
  planExpiresAt DateTime?
  trialEndsAt   DateTime? // 15-day Pro trial window (set at signup)
  autoRenew     Boolean   @default(true) // autopay mandate active — renewals debit automatically at expiry

  payments Payment[]

  journal JournalEntry[]
  savedScreens SavedScreen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// User-defined screener setups ("Create/Load Screener"). kind="filters" is a
// quick-filter view (search text / sector / sort / direction snapshot);
// kind="conditions" is a multi-condition stock filter; kind="multi" is a
// multi-scan confluence set.
// definition holds the JSON payload needed to re-run the screen.
model SavedScreen {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       String // "filters" | "conditions" | "multi"
  definition String // JSON payload (condition rows or selected scan ids + min matches)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// Professional trading journal. kind="trade" logs a position with prices and
// auto-computed P&L / R multiple; kind="note" is a pure learning/observation
// entry (market notes, mistakes review, plan write-ups).
model JournalEntry {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // "trade" | "note"
  date       String // trade/note date, YYYY-MM-DD
  title      String? // note headline (kind=note); optional trade caption
  symbol     String? // NSE symbol, e.g. RELIANCE.NS (kind=trade)
  side       String? // "long" | "short"
  entryPrice Float?
  exitPrice  Float? // null = position still open
  quantity   Float?
  stopLoss   Float?
  target     Float?
  setup      String? // setup tag (Breakout, Pullback, VCP, ...)
  confidence Int? // 1-5 conviction at entry
  wentWell   String?
  wentWrong  String?
  learning   String? // key takeaway — the heart of the journal
  notes      String? // free-form detail (kind=note body or extra trade notes)
  tags       String? // comma-separated free tags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Market calendar: NSE holidays, special sessions, F&O expiries, macro events
// (RBI MPC, FOMC, Union Budget) and earnings-season windows. Global (not per
// user), seeded from src/lib/market-calendar.ts.
model MarketEvent {
  id          String  @id @default(cuid())
  key         String  @unique // stable seed key, e.g. "nse-holiday-2026-10-02"
  date        String // YYYY-MM-DD (start)
  endDate     String? // multi-day events (RBI MPC)
  title       String
  category    String // holiday | market | expiry | macro | earnings | other
  impact      String // high | medium | low
  source      String? // NSE / RBI / Federal Reserve / TradePulse
  tentative   Boolean @default(false) // true = expected, subject to official circular
  description String? // what it is
  details     String? // why traders care + how to prepare

  @@index([date])
}

// One row per checkout attempt (Cashfree order or sandbox demo order).
model Payment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String    @default("cashfree") // cashfree | demo
  orderId   String    @unique // tp_... (Cashfree order id / demo order id)
  sessionId String? // Cashfree payment_session_id (cashfree mode only)
  cycle     String // monthly | quarterly | halfyearly | annual
  amount    Int // paise (INR * 100)
  currency  String    @default("INR")
  status    String    @default("CREATED") // CREATED | PAID | FAILED
  renewal   Boolean   @default(false) // true = autopay renewal debit (not the first authorization)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}
